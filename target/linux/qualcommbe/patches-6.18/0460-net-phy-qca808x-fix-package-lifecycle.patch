 	}
 
-	mdio_device_put(xpcs_mdiodev);
+	for (i = 0; i < ARRAY_SIZE(pcs_data->clks); i++)
+		clk_put(pcs_data->clks[i]);
+	reset_control_put(pcs_data->rstc);
