-		j = ARRAY_SIZE(xpcs_clock_names);
+	if (xpcs_data->qxgmii_enabled) {
+		ret = reset_control_assert(xpcs_data->rstc);
+		if (ret)
+			return ret;
 	}
 
-	for (i = 0; i < node; i++)
-		reset_control_put(xpcs_data->xpcs_ch[i].rstcs);
+	ret = qca8084_xpcs_restore_clock_parents(xpcs_mdiodev);
+	if (ret)
+		return ret;
 
-	of_node_put(child);
+	if (!xpcs_data->qxgmii_enabled)
