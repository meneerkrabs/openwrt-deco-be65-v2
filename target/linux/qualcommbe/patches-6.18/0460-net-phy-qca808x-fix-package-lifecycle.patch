+
+int qca8084_package_xpcs_and_pcs_remove(struct mdio_device *xpcs_mdiodev,
+					struct mdio_device *pcs_mdiodev)
+{
+	struct qca8084_xpcs_data *xpcs_data = NULL;
+	struct qca8084_pcs_data *pcs_data;
+	int channel, first_err, i, ret;
+
+	if (xpcs_mdiodev)
+		xpcs_data = mdiodev_get_drvdata(xpcs_mdiodev);
+
+	first_err = qca8084_qxgmii_unset_mode(xpcs_mdiodev, pcs_mdiodev);
+	if (first_err && xpcs_data && xpcs_data->qxgmii_enabled) {
+		pcs_data = mdiodev_get_drvdata(pcs_mdiodev);
+		clk_disable_unprepare(pcs_data->clks[PCS_CLK]);
+		xpcs_data->qxgmii_enabled = false;
+	}
+
+	if (xpcs_data) {
+		for (channel = 0; channel < QCA8084_CHANNEL_MAX; channel++) {
+			struct qca8084_xpcs_channel_priv *ch_data;
+
+			ch_data = &xpcs_data->xpcs_ch[channel];
+			for (i = 0; i < ARRAY_SIZE(ch_data->clks); i++)
+				clk_put(ch_data->clks[i]);
+			reset_control_put(ch_data->rstcs);
+		}
+		reset_control_put(xpcs_data->rstc);
+		kfree(xpcs_data);
+		mdiodev_set_drvdata(xpcs_mdiodev, NULL);
+		mdio_device_put(xpcs_mdiodev);
+	}
+
+	ret = qca8084_package_pcs_remove(pcs_mdiodev);
+	if (!first_err)
+		first_err = ret;
+
+	return first_err;
 }
 
