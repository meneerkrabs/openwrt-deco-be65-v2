+int qca8084_package_pcs_remove(struct mdio_device *pcs_mdiodev)
+{
+	struct qca8084_pcs_data *pcs_data;
+	int i, ret;
 
-	for (i = 0; i < ARRAY_SIZE(xpcs_data->xpcs_ch); i++) {
-		reset_control_put(xpcs_data->xpcs_ch[i].rstcs);
