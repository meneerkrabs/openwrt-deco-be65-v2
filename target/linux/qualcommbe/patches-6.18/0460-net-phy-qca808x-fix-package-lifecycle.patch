+}
+
+static int
+qca8084_xpcs_restore_clock_parents(struct mdio_device *xpcs_mdiodev)
+{
+	struct qca8084_xpcs_data *xpcs_data;
+	int channel, first_err = 0;
+	int ret;
+
+	if (!xpcs_mdiodev)
+		return 0;
+
+	xpcs_data = mdiodev_get_drvdata(xpcs_mdiodev);
+	if (!xpcs_data || !xpcs_data->parents_saved)
+		return 0;
+
+	for (channel = 0; channel < QCA8084_CHANNEL_MAX; channel++) {
+		struct qca8084_xpcs_channel_priv *ch_data;
+
+		ch_data = &xpcs_data->xpcs_ch[channel];
+		if (ch_data->rx_parent) {
+			ret = clk_set_parent(ch_data->clks[XPCS_RX_SRC_CLK],
+					     ch_data->rx_parent);
+			if (ret) {
+				dev_warn(&xpcs_mdiodev->dev,
+					 "channel %d: failed to restore RX clock parent: %d\n",
+					 channel, ret);
+				if (!first_err)
+					first_err = ret;
+			} else {
+				ch_data->rx_parent = NULL;
 			}
-			ch_data->clks[j] = clk;
 		}
 
-		node++;
+		if (ch_data->tx_parent) {
+			ret = clk_set_parent(ch_data->clks[XPCS_TX_SRC_CLK],
+					     ch_data->tx_parent);
+			if (ret) {
+				dev_warn(&xpcs_mdiodev->dev,
+					 "channel %d: failed to restore TX clock parent: %d\n",
+					 channel, ret);
+				if (!first_err)
+					first_err = ret;
+			} else {
+				ch_data->tx_parent = NULL;
+			}
+		}
 	}
 
-	mdiodev_set_drvdata(mdiodev, xpcs_data);
+	if (!first_err)
+		xpcs_data->parents_saved = false;
 
-	return mdiodev;
+	return first_err;
+}
+
+int qca8084_qxgmii_unset_mode(struct mdio_device *xpcs_mdiodev,
