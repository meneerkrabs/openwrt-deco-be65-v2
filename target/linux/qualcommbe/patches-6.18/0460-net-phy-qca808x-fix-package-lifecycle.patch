From: Claude Code <noreply@anthropic.com>
Subject: [PATCH] net: phy: qca808x: serialize QCA8084 package lifecycle

QCA8084 package resources are shared by four PHY devices. The generic
one-shot helpers publish their state before initialization completes and
cannot distinguish successful users from probes still in progress.

Add a package-wide mutex, serialize QCA8084 probe, configuration and
remove, and keep explicit successful-user and resource state. Build the
PHY and SerDes support as one module, unwind partial setup, disable package
clock consumers before their SerDes source, resume interrupted SerDes
cleanup, retain and reassert the package reset, pair each per-PHY reset
with devres teardown, preserve failed clock-parent state during recoverable
setup unwind, and reject ambiguous PCS/XPCS descriptions.

Signed-off-by: Claude Code <noreply@anthropic.com>
---
diff --git a/drivers/net/phy/phy_package.c b/drivers/net/phy/phy_package.c
index 39e1774..cb35594 100644
--- a/drivers/net/phy/phy_package.c
+++ b/drivers/net/phy/phy_package.c
@@ -3,6 +3,7 @@
  * PHY package support
  */
 
+#include <linux/mutex.h>
 #include <linux/of.h>
 #include <linux/phy.h>
 
@@ -15,6 +16,7 @@
  *   in one package and for offset calculation of phy_package_read/write
  * @np: Pointer to the Device Node if PHY package defined in DT
  * @refcnt: Number of PHYs connected to this shared data
+ * @lock: Serializes package-wide driver lifecycle operations
  * @flags: Initialization of PHY package
  * @priv_size: Size of the shared private data @priv
  * @priv: Driver private data shared across a PHY package
@@ -28,6 +30,8 @@ struct phy_package_shared {
 	/* With PHY package defined in DT this points to the PHY package node */
 	struct device_node *np;
 	refcount_t refcnt;
+	/* Serializes package-wide driver lifecycle operations */
+	struct mutex lock;
 	unsigned long flags;
 	size_t priv_size;
 
@@ -52,6 +56,18 @@ void *phy_package_get_priv(struct phy_device *phydev)
 }
 EXPORT_SYMBOL_GPL(phy_package_get_priv);
 
+void phy_package_lock(struct phy_device *phydev)
+{
+	mutex_lock(&phydev->shared->lock);
+}
+EXPORT_SYMBOL_GPL(phy_package_lock);
+
+void phy_package_unlock(struct phy_device *phydev)
+{
+	mutex_unlock(&phydev->shared->lock);
+}
+EXPORT_SYMBOL_GPL(phy_package_unlock);
+
 static int phy_package_address(struct phy_device *phydev,
 			       unsigned int addr_offset)
 {
@@ -237,6 +253,7 @@ int phy_package_join(struct phy_device *phydev, int base_addr, size_t priv_size)
 		shared->base_addr = base_addr;
 		shared->np = NULL;
 		refcount_set(&shared->refcnt, 1);
+		mutex_init(&shared->lock);
 		bus->shared[base_addr] = shared;
 	} else {
 		ret = -EINVAL;
@@ -338,6 +355,7 @@ void phy_package_leave(struct phy_device *phydev)
 	if (refcount_dec_and_mutex_lock(&shared->refcnt, &bus->shared_lock)) {
 		bus->shared[shared->base_addr] = NULL;
 		mutex_unlock(&bus->shared_lock);
+		mutex_destroy(&shared->lock);
 		kfree(shared->priv);
 		kfree(shared);
 	}
