+	pcs_data = mdiodev_get_drvdata(pcs_mdiodev);
+	ret = qca8084_sgmii_unset_mode(pcs_mdiodev);
+	if (ret && pcs_data->sgmii_enabled) {
+		clk_disable_unprepare(pcs_data->clks[PCS_CLK]);
